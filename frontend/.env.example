# Origin of the backend. Leave empty to use same-origin /api (Vite dev proxy or nginx).
# Example for a separately hosted backend: VITE_API_URL=https://memory.example.com
VITE_API_URL=
# Dev-only: where the Vite dev server proxies /api (defaults to http://localhost:8000)
# VITE_PROXY_TARGET=http://localhost:8000
