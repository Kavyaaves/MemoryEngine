# Memory Engine configuration. Every variable maps to a field in backend/app/config/settings.py
# (OPENAI_API_KEY ⇄ openai_api_key; names are case-insensitive).
#
# Local and Docker: cp .env.example .env   (from backend/; docker compose reads backend/.env too)
# Hosted on AWS:    set the same names as environment variables / secrets on the service instead.
#                   Real environment variables always win over a .env file.
#
# Uncommented lines need a value. Commented lines show the default, so you only set them to change it.

# --- App ---
ENVIRONMENT=production
# Signs login tokens and media links. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# ACCESS_TOKEN_TTL_MINUTES=10080
# Only needed when the frontend is served from a different origin than the API (JSON list).
# CORS_ORIGINS=["http://localhost:5173"]
# Chat exports have no timezone; their dates are read in this one.
# DEFAULT_TIMEZONE=Asia/Kolkata

# --- Database: Amazon RDS for PostgreSQL 15+ ---
# Paste it as RDS shows it; the app adds the async driver and ssl=require itself.
# URL-encode symbols in the password (@ → %40, # → %23, / → %2F).
DATABASE_URL=postgresql://postgres:<password>@<endpoint>.rds.amazonaws.com:5432/postgres
# Per process (API and worker each have a pool). A small RDS instance allows ~80 connections in total.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# --- Job queue ---
# docker-compose.yml sets this to its own Redis service. Empty = no Redis: uploads are processed in
# the API process and the worker isn't needed.
# REDIS_URL=redis://localhost:6379/0
# INLINE_INGESTION=false

# --- OpenAI ---
OPENAI_API_KEY=
# OPENAI_REASONING_MODEL=gpt-4.1-mini
# OPENAI_FAST_MODEL=gpt-4.1-nano
# OPENAI_VISION_MODEL=gpt-4.1-mini
# OPENAI_SPEECH_MODEL=gpt-4o-mini-transcribe
# Changing the embedding model after importing data re-embeds every memory.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector(768) column created by the migration.
# EMBEDDING_DIM=768
# EMBEDDING_BATCH_SIZE=256
# VECTOR_MIN_SIMILARITY=0.25

# --- Media files: Amazon DynamoDB ---
STORAGE_BACKEND=dynamodb
# Keep it the same as the RDS database.
AWS_REGION=ap-south-2
# Leave both empty to use an IAM role (EC2 instance profile / ECS task role) or ~/.aws/credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Create it once with:  python -m app.media.storage create-table
# DYNAMODB_MEDIA_TABLE=memory-engine-media
# Only used when STORAGE_BACKEND=local (development and tests).
# LOCAL_STORAGE_DIR=./data/objects

# --- Limits ---
# MAX_DAILY_REQUESTS=1500
# MAX_MONTHLY_REQUESTS=30000
# Tokens (input + output) allowed every TOKEN_WINDOW_HOURS hours; 0 = no budget.
# MAX_TOKENS_PER_WINDOW=2000000
# TOKEN_WINDOW_HOURS=24
# MAX_UPLOAD_MB=50
# MAX_IMAGE_MB=20

# --- Retrieval ---
# RETRIEVAL_TOP_K=12
# RETRIEVAL_CANDIDATES_PER_PATH=50
# RRF_K=60
# llm | heuristic | none
# RERANKER=llm
# 1.0 = off; try 0.7 to push near-duplicate memories down.
# MMR_LAMBDA=1.0

# --- Sentiment (local CPU model, baked into the Docker image) ---
# If you change SENTIMENT_MODEL, rebuild with the matching SENTIMENT_MODEL build arg.
# SENTIMENT_ENABLED=true
# SENTIMENT_MODEL=vishnuexe/TamilSense-model
# SENTIMENT_BATCH_SIZE=32
# SENTIMENT_NEUTRAL_BELOW=0.75

# --- Fine-tuning (app/finetuning/) ---
# FINETUNE_BASE_MODEL=gpt-4.1-nano-2025-04-14
# FINETUNE_DERIVED_MODEL=
# FINETUNE_TEACHER_MODEL=gpt-4.1

# --- Observability (optional) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=memory-engine
